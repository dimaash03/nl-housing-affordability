	/// PTI of the four big cities combined.
	measure 'PTI G4' = ```
			CALCULATE (
			    [Group PTI],
			    REMOVEFILTERS ( fct_group_affordability ),
			    fct_group_affordability[group_type] = "region_group",
			    fct_group_affordability[group_code] = "G4"
			)
			```
		formatString: 0.00
		displayFolder: 4 Headline
		lineageTag: 28b19398-166b-5ed1-99f6-5ce202a2bc53

	/// PTI of all municipalities outside the G4 (two-way split).
	measure 'PTI Rest of NL' = ```
			CALCULATE (
			    [Group PTI],
			    REMOVEFILTERS ( fct_group_affordability ),
			    fct_group_affordability[group_type] = "region_group",
			    fct_group_affordability[group_code] = "REST_NL"
			)
			```
		formatString: 0.00
		displayFolder: 4 Headline
		lineageTag: 7b1742bd-8339-53d0-ace6-718b1001b86d

	/// PTI of Utrecht, Noord-Holland and Zuid-Holland outside the G4 (three-way split).
	measure 'PTI Rest of Randstad provinces' = ```
			CALCULATE (
			    [Group PTI],
			    REMOVEFILTERS ( fct_group_affordability ),
			    fct_group_affordability[group_type] = "region_group_3",
			    fct_group_affordability[group_code] = "REST_RANDSTAD"
			)
			```
		formatString: 0.00
		displayFolder: 4 Headline
		lineageTag: 135f4100-0368-5041-b160-21128983d3a5

	/// Relative change of the national PTI since the base year.
	measure 'PTI change Netherlands' = ```
			CALCULATE (
			    [Group PTI change since base year],
			    REMOVEFILTERS ( fct_group_affordability ),
			    fct_group_affordability[group_type] = "nl"
			)
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Headline
		lineageTag: 8fb38832-8bc5-5831-858d-959c97bad57e

	/// Owner-occupier share of households in the G4.
	measure 'Owner-occupier share G4' = ```
			CALCULATE (
			    [Group owner-occupier share],
			    REMOVEFILTERS ( fct_group_affordability ),
			    fct_group_affordability[group_type] = "region_group",
			    fct_group_affordability[group_code] = "G4"
			)
			```
		formatString: 0%
		displayFolder: 4 Headline
		lineageTag: 70fed3ed-7e25-5b8e-b0dc-ccaf71fd7a0e

	/// Owner-occupier share of households outside the G4.
	measure 'Owner-occupier share Rest of NL' = ```
			CALCULATE (
			    [Group owner-occupier share],
			    REMOVEFILTERS ( fct_group_affordability ),
			    fct_group_affordability[group_type] = "region_group",
			    fct_group_affordability[group_code] = "REST_NL"
			)
			```
		formatString: 0%
		displayFolder: 4 Headline
		lineageTag: 3d0eb301-9ef9-538b-9a4a-e71695818528

	/// G4 PTI divided by the rest-of-NL PTI on the active income basis (F1).
	measure 'G4 ÷ Rest of NL' = ```
			DIVIDE ( [PTI G4], [PTI Rest of NL] )
			```
		formatString: 0.00"×"
		displayFolder: 4 Headline
		lineageTag: c4d4c96a-45a0-511c-9289-2514ea7e1bed

	/// G4 ÷ Rest of NL with all-household income, whatever the slicer says (D-038: shown next to the owner version).
	measure 'G4 ÷ Rest of NL (all households)' = ```
			CALCULATE ( [G4 ÷ Rest of NL], REMOVEFILTERS ( 'Income basis' ), 'Income basis'[basis_key] = "all" )
			```
		formatString: 0.00"×"
		displayFolder: 4 Headline
		lineageTag: 92b7d408-917e-5af4-a562-74923fa21717

	/// G4 ÷ Rest of NL with owner-occupier income, whatever the slicer says.
	measure 'G4 ÷ Rest of NL (owner-occupiers)' = ```
			CALCULATE ( [G4 ÷ Rest of NL], REMOVEFILTERS ( 'Income basis' ), 'Income basis'[basis_key] = "owner" )
			```
		formatString: 0.00"×"
		displayFolder: 4 Headline
		lineageTag: 68a17d72-0aa8-500e-9cba-fc5d23a56259

	/// Municipalities (in the current filter) with a positive growth gap since the base year, as a share of those with a gap (F3).
	measure 'Share of municipalities where prices outgrew incomes' = ```
			VAR gaps =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_municipality[municipality_code] ), "@gap", [Growth gap (pp)] ),
			        NOT ISBLANK ( [@gap] )
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( gaps, [@gap] > 0 ) ), COUNTROWS ( gaps ) )
			```
		formatString: 0%
		displayFolder: 4 Headline
		lineageTag: ae11d192-a5cc-5da4-98b3-2448d107d7f9

	/// OK when the imported tables have the row counts of the marts (stage 3): 5 130 / 270 / 342 / 12 / 15.
	measure 'Check row counts' = ```
			VAR nFact = COUNTROWS ( ALL ( fct_affordability ) )
			VAR nGroup = COUNTROWS ( ALL ( fct_group_affordability ) )
			VAR nMunicipality = COUNTROWS ( ALL ( dim_municipality ) )
			VAR nProvince = COUNTROWS ( ALL ( dim_province ) )
			VAR nYear = COUNTROWS ( ALL ( dim_year ) )
			VAR isOk = nFact = 342 * nYear && nGroup = 18 * nYear && nMunicipality = 342 && nProvince = 12 && nYear = 15
			RETURN
			    IF ( isOk, "OK", "CHECK" ) & ": " & nFact & " / " & nGroup & " / " & nMunicipality & " / " & nProvince & " / " & nYear
			```
		displayFolder: 9 Checks
		lineageTag: f7d7438c-5851-55db-be17-e5460e045346

	/// OK when every fact row finds its municipality and year (relationships are complete).
	measure 'Check orphan keys' = ```
			VAR orphans =
			    COUNTROWS (
			        FILTER (
			            ALL ( fct_affordability ),
			            ISBLANK ( RELATED ( dim_municipality[municipality_name] ) ) || ISBLANK ( RELATED ( dim_year[year_label] ) )
			        )
			    )
			    + COUNTROWS ( FILTER ( ALL ( fct_group_affordability ), ISBLANK ( RELATED ( dim_year[year_label] ) ) ) )
			RETURN
			    IF ( ISBLANK ( orphans ), "OK: 0 orphan rows", "CHECK: " & orphans & " orphan rows" )
			```
		displayFolder: 9 Checks
		lineageTag: caff3e61-daca-51d0-a6ac-8441e9207a16

