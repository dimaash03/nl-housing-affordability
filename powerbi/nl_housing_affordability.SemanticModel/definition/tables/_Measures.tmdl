			            )
			        ),
			        REMOVEFILTERS ( dim_year ),
			        dim_year[year] = y
			    )
			```
		formatString: € #,0
		displayFolder: 3 Group
		lineageTag: 896a35cd-5c70-5e89-9417-fb019c7e5f85

	/// Nominal change of the group price, base year to report year.
	measure 'Group price growth since base year' = ```
			VAR y0 = [Base year]
