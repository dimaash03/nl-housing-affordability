			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Group
		lineageTag: 680cdf93-aaab-51fa-84f6-0c37a70ba7cc

	/// Nominal change of the group income on the active basis, base year to report year.
	measure 'Group income growth since base year' = ```
			VAR y0 = [Base year]
			VAR incomeNow = [Group median income]
			VAR incomeBase = CALCULATE ( [Group median income], REMOVEFILTERS ( dim_year ), dim_year[year] = y0 )
