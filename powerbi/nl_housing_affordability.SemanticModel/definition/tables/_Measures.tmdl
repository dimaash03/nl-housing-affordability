	/// Change of the group price in 2025 euro (CPI-deflated), base year to report year.
	measure 'Group real price growth since base year' = ```
			VAR y = [Report year]
			VAR y0 = [Base year]
			VAR realPrice =
			    CALCULATE (
			        IF ( COUNTROWS ( fct_group_affordability ) = 1, SELECTEDVALUE ( fct_group_affordability[real_avg_sale_price_eur_2025] ) ),
			        REMOVEFILTERS ( dim_year ),
			        dim_year[year] = y
			    )
			VAR realBase =
			    CALCULATE (
			        IF ( COUNTROWS ( fct_group_affordability ) = 1, SELECTEDVALUE ( fct_group_affordability[real_avg_sale_price_eur_2025] ) ),
			        REMOVEFILTERS ( dim_year ),
			        dim_year[year] = y0
			    )
			RETURN
			    IF ( NOT ISBLANK ( realPrice ) && NOT ISBLANK ( realBase ), DIVIDE ( realPrice, realBase ) - 1 )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Group
		lineageTag: 63b133b0-9145-53f7-9cba-0912fd2f80c3

	/// Owner-occupier households / all households of the group in the report year (context card, D-038).
	measure 'Group owner-occupier share' = ```
			VAR y = [Report year]
			RETURN
			    CALCULATE (
			        IF (
			            COUNTROWS ( fct_group_affordability ) = 1,
			            DIVIDE (
			                SELECTEDVALUE ( fct_group_affordability[owner_households_count] ),
