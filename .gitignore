# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (downloaded / generated; never committed) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.duckdb
*.duckdb.wal

# --- Power BI temp / cache files (the .pbix itself IS committed) ---
~$*.pbix
*.pbix.bak
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.env
